{
  "name": "boardroom",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "dev:discord": "node scripts/with-env.mjs .env.discord next dev",
    "build": "node scripts/migrate-on-build.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:dev": "tsx --conditions=react-server --env-file=.env.local scripts/seed-dev.ts",
    "reset:demo": "tsx --conditions=react-server scripts/reset-demo.ts",
    "sync": "tsx --conditions=react-server scripts/sync.ts",
    "sync:discord": "node scripts/with-env.mjs .env.discord tsx --conditions=react-server scripts/sync.ts",
    "discord:commands": "tsx --conditions=react-server scripts/discord-commands.ts",
    "move:posts": "tsx --conditions=react-server scripts/move-posts.ts",
    "refresh:posts": "tsx --conditions=react-server scripts/refresh-posts.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.18.0",
    "better-auth": "^1.7.13",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "entities": "^7.0.1",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "papaparse": "^5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.9.1"
}
