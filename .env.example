# --- App ---------------------------------------------------------------
# Public URL of the app (http://localhost:3000 locally). On Vercel, leave it out to use the
# project's production domain; set it for a custom domain
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Database ------------------------------------------------------------
# Local: file:local.db   Production: libsql://<db>-<org>.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# --- Discord ---------------------------------------------------------------
# OAuth2 app (login) — https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token from the same application (Bot tab). Needs "Message Content Intent".
DISCORD_BOT_TOKEN=
# Right-click the server → Copy Server ID (enable Developer Mode). Its channels and roles are
# picked on the site, on Settings → Group settings
DISCORD_GUILD_ID=
# Optional: the application's Public Key (General Information tab). Turns on the buttons on
# nights' posts and the /event command; set the Interactions Endpoint URL to
# https://<your-domain>/api/discord/interactions, then run `pnpm discord:commands` once
DISCORD_PUBLIC_KEY=
# Optional: the bot's slash command, /event by default (/event new, poll, edit, cancel).
# Run `pnpm discord:commands` again after changing it
DISCORD_COMMAND_NAME=

# --- BoardGameGeek ---------------------------------------------------------
# Register at https://boardgamegeek.com/applications, then create a token
BGG_API_TOKEN=

# --- Claude ------------------------------------------------------------------
# Optional: with a key, an admin can turn on Claude's picks (Discover and a night's page) and
# reading hand-written play posts the parser can't, on Group settings
ANTHROPIC_API_KEY=

# --- Cron ----------------------------------------------------------------
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes
CRON_SECRET=

# --- Your group ---------------------------------------------------------------
# The group's name, time zone, kinds of night, Discord channels and roles are set on the site, on
# Settings → Group settings. Sites set up before it existed used environment variables, and
# anything never saved there still falls back to them: SITE_NAME, APP_TIMEZONE, CASUAL_NIGHT,
# CORE_NIGHT_NAME, CASUAL_NIGHT_NAME, CORE_NIGHT_TITLE, CASUAL_NIGHT_TITLE, HEAVY_GAME_WEIGHT,
# NIGHT_REMINDER_HOURS, CLAUDE, CLAUDE_IDEAS_PER_DAY, DISCORD_PLAYS_CHANNEL_ID,
# DISCORD_CASUAL_CHANNEL_ID, DISCORD_MEMBER_ROLE_ID, DISCORD_WELCOME_CHANNEL_ID,
# DISCORD_CORE_EVENTS_CHANNEL_ID, DISCORD_CASUAL_EVENTS_CHANNEL_ID, DISCORD_CORE_ANNOUNCE_CHANNEL_ID,
# DISCORD_CASUAL_ANNOUNCE_CHANNEL_ID, DISCORD_CORE_NIGHT_PING and DISCORD_CASUAL_NIGHT_PING.
# Locally, they're handy for a freshly seeded database (pnpm seed:dev clears Group settings):
APP_TIMEZONE=America/Chicago
CASUAL_NIGHT=

# --- Demo --------------------------------------------------------------------
# Optional: DEMO=on makes the site a public demo on a made-up group, with a database of its own:
# anyone can sign in as one of its members, every page says it's a demo, and the nightly cron
# wipes the database and puts the group back. It's ignored on a site with DISCORD_BOT_TOKEN or
# DISCORD_GUILD_ID set, so a real group's data is never wiped
DEMO=
