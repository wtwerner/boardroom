# --- App ---------------------------------------------------------------
# Public URL of the app (http://localhost:3000 locally). On Vercel, leave it out to use the
# project's production domain; set it for a custom domain
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Database ------------------------------------------------------------
# Local: file:local.db   Production: libsql://<db>-<org>.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# --- Discord ---------------------------------------------------------------
# OAuth2 app (login) — https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token from the same application (Bot tab). Needs "Message Content Intent".
DISCORD_BOT_TOKEN=
# Right-click server / channel → Copy ID (enable Developer Mode)
DISCORD_GUILD_ID=
DISCORD_PLAYS_CHANNEL_ID=
# Optional: the casual night's channel. Its plays are imported as casual night plays, and
# setting it turns the casual night on across the site (see CASUAL_NIGHT below)
DISCORD_CASUAL_CHANNEL_ID=
# Only members with this role may sign in. Leave it empty and anyone in the server can, and
# everyone who signs in can delete and merge, so set it unless the server is just the group
DISCORD_MEMBER_ROLE_ID=
# Optional: where someone invited to the core group's nights (People, or right-click → Apps →
# Invite to …) is greeted. Defaults to the core events channel, then the plays channel. Giving the
# role needs the bot to have Manage Roles, above the member role (docs/discord-setup.md, Part 5)
DISCORD_WELCOME_CHANNEL_ID=
# Optional: each kind of night's events channel, a text channel or a forum. With
# DISCORD_PUBLIC_KEY set, Boardroom posts its nights there, each with a thread and buttons to
# answer
DISCORD_CORE_EVENTS_CHANNEL_ID=
DISCORD_CASUAL_EVENTS_CHANNEL_ID=
# Optional: the application's Public Key (General Information tab). Turns on the buttons on
# nights' posts and the /event command; set the Interactions Endpoint URL to
# https://<your-domain>/api/discord/interactions, then run `pnpm discord:commands` once
DISCORD_PUBLIC_KEY=
# Optional: the bot's slash command, /event by default (/event new, /event edit, /event cancel).
# Run `pnpm discord:commands` again after changing it
DISCORD_COMMAND_NAME=
# Optional: who's pinged when a night is first posted (edits never ping): "here", "everyone",
# or a role id. Unset pings nobody. here, everyone and roles that aren't mentionable need the
# bot to have Mention @everyone, @here, and All Roles
DISCORD_CORE_NIGHT_PING=
DISCORD_CASUAL_NIGHT_PING=

# --- BoardGameGeek ---------------------------------------------------------
# Register at https://boardgamegeek.com/applications, then create a token
BGG_API_TOKEN=

# --- Claude ------------------------------------------------------------------
# Optional: CLAUDE=on turns on Claude's picks (Discover and a night's page) and reading
# hand-written play posts the parser can't. Needs ANTHROPIC_API_KEY too. Off, the site never
# calls Claude or mentions it
CLAUDE=
ANTHROPIC_API_KEY=

# Optional: Claude's picks each person can ask for in a day (default 5)
CLAUDE_IDEAS_PER_DAY=

# --- Cron ----------------------------------------------------------------
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes
CRON_SECRET=

# --- Your group (all optional) ----------------------------------------------
# The group's time zone, for play dates and night times (default UTC)
APP_TIMEZONE=America/Chicago
# The site's name (default Boardroom)
SITE_NAME=
# A casual night with guests and lighter games, as well as the group's own. Setting
# DISCORD_CASUAL_CHANNEL_ID turns it on; CASUAL_NIGHT=on does too, without Discord
CASUAL_NIGHT=
# What each kind of night is called everywhere on the site: tags, switches, charts, page text,
# Claude's prompts, and titles of nights it makes ("10/18 Game Night"). Defaults Game night, Casual night
CORE_NIGHT_NAME=
CASUAL_NIGHT_NAME=
# Games are ranked in two lists, heavy and light, split at this BGG weight (default 2.75)
HEAVY_GAME_WEIGHT=
# Hours before a night starts that its channel is reminded, pinging whoever's going or a maybe
# (default 3; 0 turns it off). Needs /api/cron/tick called through the day: see the README
NIGHT_REMINDER_HOURS=
